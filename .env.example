# ============================================================
#   Blauplug Innovation Pvt Ltd — Trading Platform
#   Environment Configuration Template
#   Copy this file to .env and fill in your credentials.
#   NEVER commit .env to version control.
# ============================================================

# ── Application ─────────────────────────────────────────────
APP_ENV=development           # development | staging | production
SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Broker Selection ─────────────────────────────────────────
# Set to: zerodha | upstox | simulated
ACTIVE_BROKER=simulated

# ── Zerodha Kite Connect v3 ──────────────────────────────────
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=        # Refresh daily via /zerodha/login

# ── Upstox API v2 ────────────────────────────────────────────
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/upstox/callback
UPSTOX_ACCESS_TOKEN=         # Stored in Redis after OAuth flow

# ── PostgreSQL ───────────────────────────────────────────────
# DOCKER: postgres   |  LOCAL: localhost
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=blauplug_trading
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blauplug_trading

# ── Redis ────────────────────────────────────────────────────
# DOCKER: redis      |  LOCAL: localhost
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# ── Apache Kafka ─────────────────────────────────────────────
# DOCKER: kafka:9092 |  LOCAL: localhost:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_MARKET_TICKS=market_ticks
KAFKA_TOPIC_ORDER_EVENTS=order_events
KAFKA_TOPIC_TRADE_EVENTS=trade_events
KAFKA_TOPIC_PORTFOLIO_UPDATES=portfolio_updates
KAFKA_TOPIC_AI_SIGNALS=ai_signals

# ── Service Ports ────────────────────────────────────────────
API_GATEWAY_PORT=8000
MARKET_DATA_PORT=8001
ORDER_MANAGEMENT_PORT=8002
TRADE_EXECUTION_PORT=8003
AI_SIGNAL_PORT=8004
DASHBOARD_PORT=8080

# ── AI / ML ──────────────────────────────────────────────────
MODEL_PATH=/app/models/lstm_model.pt
TRAINING_LOOKBACK_DAYS=365
PREDICTION_HORIZON=5

# ── Monitoring ───────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
